<div style="max-width: 600px; margin: 2rem auto; padding: 1.5rem; background-color: var(--card-bg, #12181b); border-radius: 12px; border: 1px solid var(--border-color, #2a3439); color: #fff;">
  <h1 style="margin: 0 0 1.5rem 0; font-size: 1.6rem; color: #00f2fe;">
    <%= fornecedor.new_record? ? "🚚 Novo Fornecedor" : "✏️ Editar Fornecedor" %>
  </h1>

  <%= form_with(model: fornecedor, url: fornecedor.new_record? ? fornecedores_path : fornecedore_path(fornecedor), local: true) do |f| %>
    <% if fornecedor.errors.any? %>
      <div style="color: #ff6b6b; background: rgba(255,107,107,0.1); padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem;">
        <p style="margin: 0; font-weight: bold;"><%= pluralize(fornecedor.errors.count, "erro") %> impediram este fornecedor de ser salvo:</p>
        <ul style="margin: 0.5rem 0 0 1rem; padding: 0;">
          <% fornecedor.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 1rem;">
      <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Nome / Razão Social</label>
      <%= f.text_field :nome, required: true, style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px; box-sizing: border-box;" %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Contato / Telefone</label>
        <%= f.text_field :contato, style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px; box-sizing: border-box;" %>
      </div>

      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Categorias de Produtos</label>
        <%= f.text_field :categorias, placeholder: "Ex: Eletrônicos, Embalagens", style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px; box-sizing: border-box;" %>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Prazo de Entrega</label>
        <%= f.text_field :prazo_entrega, placeholder: "Ex: 5 dias úteis", style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px; box-sizing: border-box;" %>
      </div>

      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Forma de Pagamento</label>
        <%= f.text_field :forma_pagamento, placeholder: "Ex: Faturado 30 dias, Pix", style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px; box-sizing: border-box;" %>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem;">
      <%= link_to "← Voltar", fornecedores_path, style: "color: #aaa; text-decoration: none;" %>
      <%= f.submit "Salvar Fornecedor", style: "background: #00f2fe; color: #000; font-weight: bold; padding: 0.6rem 1.5rem; border: none; border-radius: 6px; cursor: pointer;" %>
    </div>
  <% end %>
</div>