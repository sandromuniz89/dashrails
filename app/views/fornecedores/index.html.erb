<div style="max-width: 1000px; margin: 2rem auto; color: #fff;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 style="margin: 0; font-size: 1.8rem;">🚚 Fornecedores</h1>
    <%= link_to "+ NOVO FORNECEDOR", new_fornecedore_path, style: "background: #00f2fe; color: #000; font-weight: bold; padding: 0.6rem 1.2rem; border-radius: 8px; text-decoration: none;" %>
  </div>

  <div style="background: var(--card-bg, #12181b); border: 1px solid var(--border-color, #2a3439); border-radius: 12px; overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid #2a3439; background: rgba(0,0,0,0.2); color: #888;">
          <th style="padding: 1rem;">Nome</th>
          <th style="padding: 1rem;">Contato</th>
          <th style="padding: 1rem;">Categorias</th>
          <th style="padding: 1rem;">Prazo</th>
          <th style="padding: 1rem;">Pagamento</th>
          <th style="padding: 1rem; text-align: right;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @fornecedores.each do |fornecedor| %>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
            <td style="padding: 1rem; font-weight: bold; color: #00f2fe;"><%= fornecedor.nome %></td>
            <td style="padding: 1rem;"><%= fornecedor.contato.presence || "-" %></td>
            <td style="padding: 1rem;"><%= fornecedor.categorias.presence || "-" %></td>
            <td style="padding: 1rem;"><%= fornecedor.prazo_entrega.presence || "-" %></td>
            <td style="padding: 1rem;"><%= fornecedor.forma_pagamento.presence || "-" %></td>
            <td style="padding: 1rem; text-align: right;">
              <%= link_to "Ver", fornecedore_path(fornecedor), style: "color: #00f2fe; text-decoration: none; margin-right: 0.5rem;" %>
              <%= link_to "Editar", edit_fornecedore_path(fornecedor), style: "color: #aaa; text-decoration: none;" %>
            </td>
          </tr>
        <% end %>
        <% if @fornecedores.empty? %>
          <tr>
            <td colspan="6" style="padding: 2rem; text-align: center; color: #888;">Nenhum fornecedor cadastrado ainda.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>