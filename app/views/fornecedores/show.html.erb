<div style="max-width: 650px; margin: 2rem auto; padding: 1.5rem; background-color: var(--card-bg, #12181b); border-radius: 12px; border: 1px solid var(--border-color, #2a3439); color: #fff;">
  <% if notice.present? %>
    <p style="color: #00f2fe; background: rgba(0,242,254,0.1); padding: 0.75rem; border-radius: 6px; margin-bottom: 1.5rem;"><%= notice %></p>
  <% end %>

  <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
    <span style="font-size: 2.5rem;">🚚</span>
    <div>
      <h2 style="margin: 0; font-size: 1.8rem; font-weight: 700;"><%= @fornecedor.nome %></h2>
      <span style="background: rgba(255,255,255,0.1); padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.85rem; color: #aaa;">
        <%= @fornecedor.categorias.presence || "Geral" %>
      </span>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
    <div>
      <small style="color: #888; display: block;">Contato</small>
      <strong style="font-size: 1rem;"><%= @fornecedor.contato.presence || "-" %></strong>
    </div>
    <div>
      <small style="color: #888; display: block;">Prazo de Entrega</small>
      <strong style="font-size: 1rem;"><%= @fornecedor.prazo_entrega.presence || "-" %></strong>
    </div>
    <div>
      <small style="color: #888; display: block;">Forma de Pagamento</small>
      <span><%= @fornecedor.forma_pagamento.presence || "-" %></span>
    </div>
  </div>

  <div style="display: flex; gap: 1rem; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem;">
    <%= link_to "← Voltar", fornecedores_path, style: "color: #aaa; text-decoration: none;" %>
    
    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <%= link_to "EDITAR", edit_fornecedore_path(@fornecedor), style: "text-decoration: none; padding: 0.5rem 1rem; background: #00f2fe; color: #000; font-weight: bold; border-radius: 6px; font-size: 0.85rem; height: 38px; display: inline-flex; align-items: center; box-sizing: border-box;" %>
      <%= button_to "Excluir", fornecedore_path(@fornecedor), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir este fornecedor?" }, form_class: "inline-form", style: "background: #ff4757; color: white; border: none; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 0.85rem; height: 38px; display: inline-flex; align-items: center; box-sizing: border-box;" %>
    </div>
  </div>
</div>