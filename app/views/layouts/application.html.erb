<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Dash Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      :root {
        --sidebar-width: 240px;
        --sidebar-collapsed-width: 70px;
        --bg-dark: #090e11;
        --card-bg: #12181b;
        --border-color: #2a3439;
        --accent-neon: #00f2fe;
        --text-color: #e0e6ed;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: var(--bg-dark);
        color: var(--text-color);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        display: flex;
        min-height: 100vh;
      }

      /* Estilos da Sidebar */
      #sidebar {
        width: var(--sidebar-width);
        background-color: var(--card-bg);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        transition: width 0.3s ease;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 1000;
        overflow-x: hidden;
      }

      #sidebar.collapsed {
        width: var(--sidebar-collapsed-width);
      }

      /* Header da Sidebar com botão de fechar/abrir */
      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 1rem;
        border-bottom: 1px solid var(--border-color);
      }

      .sidebar-brand {
        font-weight: 800;
        font-size: 1.2rem;
        color: var(--accent-neon);
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .toggle-btn {
        background: transparent;
        border: 1px solid var(--border-color);
        color: #888;
        border-radius: 6px;
        cursor: pointer;
        padding: 0.4rem 0.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s, border-color 0.2s;
      }

      .toggle-btn:hover {
        color: var(--accent-neon);
        border-color: var(--accent-neon);
      }

      /* Links de Navegação */
      .nav-list {
        list-style: none;
        padding: 1rem 0.5rem;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .nav-item a {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.75rem 0.9rem;
        color: #aaa;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 500;
        white-space: nowrap;
        transition: background 0.2s, color 0.2s;
      }

      .nav-item a:hover {
        background: rgba(0, 242, 254, 0.08);
        color: var(--accent-neon);
      }

      .nav-item.active a {
        background: rgba(0, 242, 254, 0.15);
        color: var(--accent-neon);
        font-weight: 700;
      }

      .nav-icon {
        font-size: 1.2rem;
        min-width: 24px;
        text-align: center;
      }

      .nav-text {
        transition: opacity 0.2s ease;
      }

      #sidebar.collapsed .nav-text,
      #sidebar.collapsed .sidebar-brand span {
        opacity: 0;
        pointer-events: none;
        display: none;
      }

      /* Área de Conteúdo Principal */
      #main-wrapper {
        margin-left: var(--sidebar-width);
        flex: 1;
        padding: 1.5rem 2rem;
        transition: margin-left 0.3s ease;
        width: calc(100% - var(--sidebar-width));
        box-sizing: border-box;
      }

      #main-wrapper.expanded {
        margin-left: var(--sidebar-collapsed-width);
        width: calc(100% - var(--sidebar-collapsed-width));
      }
    </style>
  </head>

  <body>
    <!-- Barra Lateral (Sidebar) -->
    <aside id="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-brand">
          ⚡ <span>Dash Rails</span>
        </div>
        <button id="toggleSidebar" class="toggle-btn" title="Minimizar / Expandir Menu">
          ☰
        </button>
      </div>

      <ul class="nav-list">
        <li class="nav-item <%= 'active' if controller_name == 'dashboard' %>">
          <%= link_to root_path do %>
            <span class="nav-icon">📊</span>
            <span class="nav-text">Dashboard</span>
          <% end %>
        </li>

      <ul class="nav-list">
        <li class="nav-item <%= 'active' if controller_name == 'produtos' %>">
          <%= link_to produtos_path do %>
            <span class="nav-icon">📦</span>
            <span class="nav-text">Produtos</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'pedidos' %>">
          <%= link_to pedidos_path do %>
            <span class="nav-icon">🛍️</span>
            <span class="nav-text">Pedidos</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'clientes' %>">
          <%= link_to clientes_path do %>
            <span class="nav-icon">👥</span>
            <span class="nav-text">Clientes</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'fornecedores' %>">
          <%= link_to fornecedores_path do %>
            <span class="nav-icon">🚚</span>
            <span class="nav-text">Fornecedores</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'financeiro' %>">
          <%= link_to financeiro_index_path do %>
            <span class="nav-icon">💰</span>
            <span class="nav-text">Financeiro</span>
          <% end %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'relatorios' %>">
          <%= link_to relatorios_path do %>
            <span class="nav-icon">📈</span>
            <span class="nav-text">Relatório</span>
          <% end %>
        </li>
      </ul>
    </aside>

    <!-- Conteúdo Principal -->
    <main id="main-wrapper">
      <%= yield %>
    </main>

    <script>
      document.addEventListener("turbo:load", function() {
        const sidebar = document.getElementById("sidebar");
        const mainWrapper = document.getElementById("main-wrapper");
        const toggleBtn = document.getElementById("toggleSidebar");

        if (!toggleBtn) return;

        // Recupera o estado anterior do usuário (se estava recolhido ou não)
        if (localStorage.getItem("sidebar-collapsed") === "true") {
          sidebar.classList.add("collapsed");
          mainWrapper.classList.add("expanded");
        }

        toggleBtn.addEventListener("click", function() {
          sidebar.classList.toggle("collapsed");
          mainWrapper.classList.toggle("expanded");

          const isCollapsed = sidebar.classList.contains("collapsed");
          localStorage.setItem("sidebar-collapsed", isCollapsed);
        });
      });
    </script>
  </body>
</html>