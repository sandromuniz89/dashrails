<div style="max-width: 700px; margin: 2rem auto; padding: 1.5rem; background-color: var(--card-bg, #12181b); border-radius: 12px; border: 1px solid var(--border-color, #2a3439); color: #fff;">
  <h1 style="margin: 0 0 1.5rem 0; font-size: 1.6rem; color: #00f2fe;">🛍️ Novo Pedido</h1>

  <%= form_with(model: @pedido, local: true) do |f| %>
    <% if @pedido.errors.any? %>
      <div style="color: #ff6b6b; background: rgba(255,107,107,0.1); padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem;">
        <p style="margin: 0; font-weight: bold;"><%= pluralize(@pedido.errors.count, "erro") %> impediram este pedido de ser salvo:</p>
        <ul style="margin: 0.5rem 0 0 1rem; padding: 0;">
          <% @pedido.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Dados Gerais -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Cliente</label>
        <%= f.collection_select :cliente_id, Cliente.all, :id, :nome, { include_blank: "Cliente Avulso" }, { style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px;" } %>
      </div>

      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Status do Pedido</label>
        <%= f.select :status, ["Pendente", "Aprovado", "Em separação", "Enviado", "Concluído", "Cancelado"], {}, { style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px;" } %>
      </div>
    </div>

    <!-- Pagamento e Logística -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Forma de Pagamento</label>
        <%= f.select :forma_pagamento, ["Pix", "Cartão de Crédito", "Cartão de Débito", "Dinheiro", "Boleto"], { include_blank: "Selecione..." }, { style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px;" } %>
      </div>

      <div>
        <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.9rem;">Tipo de Logística</label>
        <%= f.select :tipo_logistica, ["Retirada no Balcão", "Entrega Própria", "Correios", "Motoboy"], { include_blank: "Selecione..." }, { style: "width: 100%; padding: 0.6rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px;" } %>
      </div>
    </div>

    <!-- Itens do Pedido -->
    <h3 style="border-bottom: 1px solid #2a3439; padding-bottom: 0.5rem; margin-top: 2rem; color: #00f2fe; font-size: 1.1rem;">Itens do Pedido</h3>

    <%= f.fields_for :item_pedidos do |item_f| %>
      <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 1rem; background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem; align-items: center;">
        <div>
          <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.85rem;">Produto</label>
          <%= item_f.collection_select :produto_id, Produto.all, :id, :nome, { prompt: "Selecione o produto" }, { style: "width: 100%; padding: 0.5rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px;" } %>
        </div>

        <div>
          <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.85rem;">Quantidade</label>
          <%= item_f.number_field :quantidade, min: 1, value: 1, style: "width: 100%; padding: 0.5rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px;" %>
        </div>

        <div>
          <label style="display: block; margin-bottom: 0.3rem; color: #aaa; font-size: 0.85rem;">Preço Un. (R$)</label>
          <%= item_f.number_field :preco_unitario, step: 0.01, placeholder: "Auto", style: "width: 100%; padding: 0.5rem; background: #000; border: 1px solid #2a3439; color: #fff; border-radius: 6px;" %>
        </div>
      </div>
    <% end %>

    <!-- Botões -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem;">
      <%= link_to "← Voltar", pedidos_path, style: "color: #aaa; text-decoration: none;" %>
      <%= f.submit "Salvar Pedido", style: "background: #00f2fe; color: #000; font-weight: bold; padding: 0.6rem 1.5rem; border: none; border-radius: 6px; cursor: pointer;" %>
    </div>
  <% end %>
</div>