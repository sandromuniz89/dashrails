<div id="<%= dom_id produto %>">
  <div>
    <strong>Nome:</strong>
    <%= produto.nome %>
  </div>

  <div>
    <strong>Categoria:</strong>
    <%= produto.categoria %>
  </div>

  <div>
    <strong>Emoji:</strong>
    <%= produto.emoji %>
  </div>

  <div>
    <strong>Preco custo:</strong>
    <%= produto.preco_custo %>
  </div>

  <div>
    <strong>Preco venda:</strong>
    <%= produto.preco_venda %>
  </div>

  <div>
    <strong>Quantidade:</strong>
    <%= produto.quantidade %>
  </div>

  <div>
    <strong>Estoque minimo:</strong>
    <%= produto.estoque_minimo %>
  </div>

  <div>
    <strong>Codigo:</strong>
    <%= produto.codigo %>
